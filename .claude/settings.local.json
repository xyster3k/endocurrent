{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(cat:*)",
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(git reset:*)",
      "Bash(npx opennextjs-cloudflare build:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm view:*)",
      "Bash(npm run build:cloudflare:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(while read file)",
      "Bash(do sed -i '/^export const runtime = \"\"edge\"\";$/d' \"$file\")",
      "Bash(echo:*)",
      "Bash(done)"
    ]
  }
}
